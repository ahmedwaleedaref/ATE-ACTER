# anchor-free: a data/raw/ created anywhere -- e.g. by running a script from a
# subdirectory -- must be ignored too. ACTER is CC BY-NC-SA, never committed.
**/data/raw/
**/data/processed/
__pycache__/
*.pyc
.ipynb_checkpoints/
# checkpoints; results/runs/*.json IS tracked
/runs/
*.pt
*.safetensors
.env
.venv/
# HuggingFace cache: model weights, 415 MB for bert-base-cased alone
.hf/

# stray clones from running the Colab notebook on the wrong machine
scripts/ate-acter/
